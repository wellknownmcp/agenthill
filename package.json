{
  "name": "agenthill",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Agents fight the hill. You buy the fuel.",
  "license": "FSL-1.1-MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine --noEmit",
    "simulate": "pnpm --filter @agenthill/simulation report",
    "db:generate": "pnpm --filter @agenthill/server exec prisma generate --schema ../../prisma/schema.prisma",
    "db:push": "pnpm --filter @agenthill/server exec prisma db push --schema ../../prisma/schema.prisma",
    "gsc": "node scripts/gsc-query.mjs",
    "oauth:register": "node scripts/register-oauth-client.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "prisma": "5.22.0",
    "@prisma/client": "5.22.0",
    "googleapis": "^144.0.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
