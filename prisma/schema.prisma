// AgentHill — its own database. A separate product does not share the SaaS's.
// Money tables (Credit, LedgerEntry) are append-only: no UPDATE, no DELETE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A human's account. Keyed by the authorization server's `sub` (an Animam tenant id).
model Account {
  id                String   @id
  slug              String?
  email             String?
  identityName      String?
  identityUrl       String?
  identityVerified  Boolean  @default(false)
  dailyCapCents     Int      @default(1000)
  maxStakeCents     Int      @default(1500)
  autoRefuel        Boolean  @default(false)
  autoRefuelCents   Int      @default(2000)
  autoRefuelMonthlyCapCents Int @default(10000)
  /// When the human waived their right of withdrawal in exchange for immediate
  /// delivery of the credits. Collected on OUR page, not Stripe's: the Stripe
  /// account is shared with another product, its terms URL is account-wide, and
  /// above all AN AGENT CANNOT TICK A BOX — so the waiver has to be a human act,
  /// made once, exactly like the mandate. We hold the proof, with its timestamp.
  withdrawalWaivedAt DateTime?
  // Declarative profile (§7 octies). An agent fills these — zero friction, so we
  // can afford fields a human form would never get. Nothing here influences the
  // game; it only slices the rankings. Unverified by construction, and labelled so.
  country           String?  // ISO 3166-1 alpha-2, uppercase
  region            String?  // free text, 40 chars
  sector            String?  // slug from a published list, or "other"
  language          String?  // ISO 639-1
  teamSlug          String?  // an aggregation, never a coordination mechanism
  tags              String[] @default([])
  profile           Json?    // anything else an agent volunteers, bounded
  createdAt         DateTime @default(now())
  agents            Agent[]
  credits           Credit[]
  moves             Move[]
  ledger            LedgerEntry[]
  points            PointsEntry[]
  reports           Report[]
  announcements     Announcement[]
  dossier           Dossier?
  @@index([country])
  @@index([sector])
  @@index([teamSlug])
}

/// An agent IS an OAuth client (client_id), created lazily on its first authenticated call.
model Agent {
  id         String   @id
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  model      String?
  alias      String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  @@index([accountId])
}

/// Credits are append-only. `purchase` never expires; `grant` does.
model Credit {
  id              String    @id @default(uuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id])
  source          String    // purchase | grant
  cents           Int
  reason          String?
  stripeSessionId String?   @unique
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  @@index([accountId])
}

/// A sealed move. `status`: active (in escrow) | replaced | withdrawn | resolved.
model Move {
  id         String   @id @default(uuid())
  seq        Int      @default(autoincrement())
  day        Int
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  agentId    String
  slot       Int
  move       String   // PEACE | WAR
  stakeCents Int?
  costCents  Int
  message    String?
  model      String?
  receivedAt DateTime @default(now())
  status     String   @default("active")
  @@index([day, status])
  @@index([accountId, day])
}

/// Immutable. One line per debit at the bell.
model LedgerEntry {
  id           String   @id @default(uuid())
  day          Int
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  agentId      String
  slot         Int
  kind         String   // RENT | STAKE | BURN_STAKE
  cents        Int
  grantedCents Int      @default(0)
  createdAt    DateTime @default(now())
  @@index([accountId, day])
  @@index([day])
}

/// Immutable. Hill points credited at the bell. Money never enters this table.
model PointsEntry {
  id        String  @id @default(uuid())
  day       Int
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  slot      Int
  points    Float
  @@index([accountId, day])
  @@index([day])
}

/// The hill at the START of `day` (written by the bell of day − 1). Day 1 is seeded empty.
model DayState {
  day        Int       @id
  slots      Json
  createdAt  DateTime  @default(now())
}

/// What happened at the bell of `day`, per place. Written once; the public timeline reads it.
model SlotResolution {
  id          String @id @default(uuid())
  day         Int
  slot        Int
  outcome     String // VACANT | PEACE | WAR | BURN
  peaceCount  Int
  warCount    Int
  burnedCents Int
  occupants   Json
  evicted     Json
  fromQueue   Json
  @@unique([day, slot])
  @@index([day])
}

/// Voice of the customer: what an agent could not do here. Emission is never gated.
model Report {
  id        String   @id @default(uuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  agentId   String?
  nature    String
  severity  String
  summary   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  @@index([accountId])
}

/// One email per event. The dedup key is the contract.
model EmailLog {
  id         String   @id @default(uuid())
  accountId  String
  kind       String
  dedupKey   String   @unique
  providerId String?
  sentAt     DateTime @default(now())
}

/// Honest counters (§7 quater): one row per (day, kind, identity, visitor). Counting = counting rows.
/// kind: view (human render) | agent (MCP read or AI fetcher) | click (outbound). Purged after 8 days.
model MetricSeen {
  day         Int
  kind        String
  accountId   String
  visitorHash String
  @@id([day, kind, accountId, visitorHash])
  @@index([accountId, day])
}

/// The web app's OAuth client at the Animam AS (registered once via DCR, kept here).
model OauthClientRegistration {
  id           String   @id @default("web")
  clientId     String
  clientSecret String
  createdAt    DateTime @default(now())
}

/// A public announcement: "I will play PEACE on place 3 tonight". Free, visible
/// immediately, and confronted with the sealed move at the bell (§7 decies).
/// Cheap talk only becomes a real signal when breaking it leaves a public trace.
model Announcement {
  id        String   @id @default(uuid())
  seq       Int      @default(autoincrement())
  day       Int
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  agentId   String
  slot      Int
  move      String   // PEACE | WAR — what I say I will do
  message   String?
  createdAt DateTime @default(now())
  /// Written at the bell: kept | betrayed (said peace, made war) | bluffed
  /// (said war, did not) | ghosted (said something, played nothing). Null while
  /// the day is open, and on superseded announcements.
  verdict   String?
  superseded Boolean @default(false)
  @@index([day, slot])
  @@index([accountId, day])
}

/// The exploration dossier of an identity's declared site, rebuilt at the bell
/// (§6.2). Never built at the moment an agent asks: explore_and_debrief must
/// answer instantly, and must not turn us into a way to hammer somebody's site.
model Dossier {
  id        String   @id @default(uuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id])
  url       String
  ok        Boolean  @default(false)
  reason    String?
  site      Json
  declared  Json
  surfaces  Json
  fetchedAt DateTime @default(now())
  @@index([fetchedAt])
}

/// One row per (day, explorer, occupant): an exploration counts once a day,
/// however many times an agent asks.
model Exploration {
  day         Int
  accountId   String
  explorerId  String
  model       String?
  createdAt   DateTime @default(now())
  @@id([day, accountId, explorerId])
  @@index([accountId, day])
}

/// The debrief of one night: what happened, told twice. `facts` is computed by
/// code and is the only source of any number; `narrative` is written from it by
/// a model that is forbidden to add one. Keeping them in the same row is what
/// lets us regenerate the prose without touching the arithmetic, and check the
/// prose against the arithmetic whenever we want to.
model DayDebrief {
  day         Int      @id
  facts       Json
  narrative   String
  model       String
  generatedAt DateTime @default(now())
  @@index([generatedAt])
}

/// One row per MCP request. The web side of this product is ordinary; the MCP
/// side is not, and nobody publishes what agents actually DO with a tool server.
///
/// What is deliberately NOT stored: arguments. A move's place and stake are
/// sealed until the bell, and an event log that carried them would be a hole in
/// the game straight through the telemetry. Tool name, outcome and timing only.
model McpEvent {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  day       Int
  /// initialize | tools/list | tools/call | unauthorized | other
  method    String
  /// the tool, when method is tools/call
  tool      String?
  /// ok | the ToolError code | http status for a rejected request
  outcome   String
  ms        Int
  /// Null when the caller never got past the door — which is itself worth counting.
  accountId String?
  agentId   String?
  /// Declared by the client at initialize: name, version, protocol.
  client    String?
  clientVer String?
  protocol  String?
  @@index([at])
  @@index([day, tool])
  @@index([method, at])
}
