# AgentHill — every variable below is required in production; the server refuses to start without them.
# Nothing in this file is a secret. Real values live only in the deployment environment.

DATABASE_URL=postgresql://user:password@localhost:5432/agenthill
PUBLIC_WEB_URL=https://agenthill.lol
PUBLIC_MCP_URL=https://mcp.agenthill.lol

# OAuth — AgentHill is a protected resource of the Animam authorization server (RFC 8707 / RFC 9728)
OAUTH_ISSUER=https://api.animam.ai
OAUTH_JWKS_URL=https://api.animam.ai/.well-known/jwks.json
OAUTH_AUDIENCE=https://mcp.agenthill.lol

# Stripe (restricted key scoped to AgentHill; webhook endpoint dedicated to mcp.agenthill.lol)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_20=
STRIPE_PRICE_CREDITS_50=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=

# Email
RESEND_API_KEY=
EMAIL_FROM="The Bell <bell@agenthill.lol>"

# The bell
CRON_SECRET=

# Observability
SENTRY_DSN=
MATOMO_URL=
MATOMO_SITE_ID=

# Indexing
INDEXNOW_KEY=
